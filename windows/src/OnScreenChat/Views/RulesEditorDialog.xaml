<ContentDialog
    x:Class="OnScreenChat.Views.RulesEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Standing rules"
    CloseButtonText="Done"
    SecondaryButtonText="Remove all"
    DefaultButton="Close">

    <StackPanel Spacing="10" Width="440">
        <TextBlock
            TextWrapping="Wrap"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Applied to every reply, in every skill, until you remove them. Add one from the chat box with /command {…}." />

        <Border
            CornerRadius="6"
            BorderThickness="1"
            Height="200"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <ListView x:Name="RuleList" SelectionMode="None" Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="EmptyLabel"
                    Text="No rules yet."
                    Opacity="0.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="DraftBox"
                Grid.Column="0"
                PlaceholderText="Add a rule…"
                KeyDown="OnDraftKeyDown" />

            <Button x:Name="AddButton" Grid.Column="1" Content="Add" Click="OnAdd" />
            <Button x:Name="DeleteButton" Grid.Column="2" Content="Delete last" Click="OnDeleteLast" />
        </Grid>
    </StackPanel>
</ContentDialog>

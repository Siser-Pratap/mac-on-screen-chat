<ContentDialog
    x:Class="OnScreenChat.Views.SkillEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Skill"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" Width="440">
        <TextBox x:Name="NameBox" Header="Name" TextChanged="OnNameChanged" />
        <TextBox x:Name="HintBox" Header="Input hint" />
        <TextBox
            x:Name="PromptBox"
            Header="System prompt"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="220"
            FontFamily="Consolas"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </StackPanel>
</ContentDialog>

<UserControl
    x:Class="OnScreenChat.Views.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Margin="0,5">

        <!-- A local acknowledgement (a saved rule): centred and quiet, not a chat turn. -->
        <Border
            x:Name="NoteBubble"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Padding="12,7"
            CornerRadius="10"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <TextBlock
                x:Name="NoteText"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                Opacity="0.75"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>

        <!-- A normal turn. -->
        <Grid x:Name="TurnRow" Visibility="Collapsed" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="Bubble"
                Grid.Column="0"
                Padding="12,8"
                CornerRadius="12"
                MaxWidth="320">
                <StackPanel Spacing="6">
                    <ProgressRing
                        x:Name="Spinner"
                        Visibility="Collapsed"
                        IsActive="True"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        x:Name="BodyText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        LineHeight="19" />
                </StackPanel>
            </Border>

            <Button
                x:Name="CopyButton"
                Grid.Column="1"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                Padding="6"
                Opacity="0.45"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCopy"
                ToolTipService.ToolTip="Copy reply">
                <FontIcon x:Name="CopyGlyph" FontSize="12" Glyph="&#xE8C8;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(CoreTargetFramework)-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>OnScreenChat</RootNamespace>
    <AssemblyName>OnScreenChat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>

    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Program.cs provides Main, so the single-instance check runs before any
         UI is created. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Unpackaged, self-contained: no MSIX identity, and the user does not
         need the Windows App SDK runtime pre-installed. The equivalent of the
         Mac app's unsigned local .app bundle. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Still unpackaged. This only says "use the Windows App SDK's own PRI /
         MSIX build tasks", which ship in the NuGet package. Without it the
         build falls back to Visual Studio's AppxPackage targets, so
         resources.pri generation needs a VS install and fails on a plain
         dotnet SDK (MSB4062: Microsoft.Build.Packaging.Pri.Tasks). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- The XAML compiler emits partial classes that don't carry nullable
         annotations, so the solution-wide warnings-as-errors setting would fail
         the build on generated code we don't own. Core and the tests keep it. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned from a verified restore. Bump deliberately, not by floating. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon is loaded from disk at runtime (LoadImage), so it has to
         sit next to the executable rather than be embedded as a resource. -->
    <Content Include="Assets\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnScreenChat.Core\OnScreenChat.Core.csproj" />
  </ItemGroup>

</Project>

<Project>

  <!-- Shared settings for every project under windows/.
       Retargeting to .NET 8 LTS is a one-line change here: set
       CoreTargetFramework to net8.0 (the WinUI head adds its own
       -windows10.0.19041.0 platform suffix). -->
  <PropertyGroup>
    <CoreTargetFramework>net10.0</CoreTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>

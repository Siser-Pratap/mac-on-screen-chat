# ─────────────────────────────────────────────────────────────
# Secrets — never commit API keys
# ─────────────────────────────────────────────────────────────
.env
*.env
!.env.example
secrets.json

# ─────────────────────────────────────────────────────────────
# macOS app — Swift Package Manager
# ─────────────────────────────────────────────────────────────
.build/
.swiftpm/
Package.resolved

# Built app bundle
MacOnScreenChat.app/

# Xcode (if/when we generate a project later)
*.xcodeproj/xcuserdata/
DerivedData/

# ─────────────────────────────────────────────────────────────
# Windows app — .NET / WinUI 3
#
# NOTE: do NOT add `*.g.cs` here. The prompt files generated by
# windows/tools/sync-prompts.py (SkillDefaults.g.cs and friends)
# use that suffix and are deliberately committed — they are what
# keeps the two apps' system prompts identical.
# ─────────────────────────────────────────────────────────────

# Build output
[Bb]in/
[Oo]bj/
publish/
*.binlog
msbuild.log

# Visual Studio / Rider user state
.vs/
.idea/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# Test + coverage output
[Tt]est[Rr]esult*/
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info

# NuGet
packages/
*.nupkg
project.lock.json

# MSIX / app packaging (unused today — the app ships unpackaged)
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.msix
*.msixbundle
*.pfx

# ─────────────────────────────────────────────────────────────
# Tooling
# ─────────────────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────
# OS cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# Local build output for download (may contain .env secrets) — never commit.
dist/
*.zip
